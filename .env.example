# คัดลอกเป็น .env.local แล้วใส่ค่าจริง (ห้าม commit .env.local)

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Secret key (sb_secret_...) หรือ service_role key — ใช้ฝั่ง server เท่านั้น ห้ามใส่ใน NEXT_PUBLIC_*
SUPABASE_SECRET_KEY=

# --- LINE Messaging API (LINE Developers Console → Messaging API channel) ---
# Basic settings → Channel secret
LINE_CHANNEL_SECRET=
# Messaging API → Channel access token (long-lived) — ค่าเดียวกับที่ระบบเดิมเก็บใน Script Properties
LINE_CHANNEL_ACCESS_TOKEN=

# --- LINE MINI App (LINE Developers Console → LINE MINI App channel → Web app settings) ---
# ช่องนี้ใส่ LIFF ID ของ MINI App (ยังเป็น LIFF ID รูปแบบเดิม) — แต่ละ internal channel มี ID ของตัวเอง
#   เครื่อง dev / preview  → LIFF ID ของ "Developing" (เปิดได้เฉพาะ tester ที่เพิ่มไว้ใน channel)
#   production บน Vercel   → LIFF ID ของ "Published"
NEXT_PUBLIC_LIFF_ID=

# URL ของเว็บนี้ (ใช้สร้างลิงก์เมื่อไม่มี NEXT_PUBLIC_LIFF_ID) เช่น https://recruit.example.com
APP_BASE_URL=

# ไม่บังคับ
# LINE_LOGIN_CHANNEL_ID=          # Channel ID ที่ใช้ตรวจ ID token — ปกติดึงจาก LIFF ID เองได้ ตั้งเมื่อ LINE ตอบว่า client_id ไม่ตรง
# LINE_LOGO_URL=https://...       # โลโก้บนการ์ด LINE (ต้องเป็น HTTPS สาธารณะ)
# MAX_UPLOAD_MB=10                # ขนาดไฟล์สูงสุดที่รับผ่านแชท (ระบบเดิมจำกัด 2 MB)
