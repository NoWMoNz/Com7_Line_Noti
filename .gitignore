/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ไฟล์ตัวอย่างค่าตั้งค่า (ไม่มีค่าลับ) ให้ commit ได้
!.env.example

# ไฟล์ export จาก Google Sheets มีข้อมูลส่วนบุคคล ห้าม commit
*export*.json

.vercel
.env*

# ข้อมูลจริงจากชีทเดิม (มีข้อมูลส่วนบุคคล) — ห้าม commit / ห้ามอัปโหลด
*.xlsx
*.xls
*.csv
